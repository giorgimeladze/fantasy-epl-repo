# Template for /etc/fantasy-epl/env on the server (owner root, mode 600), read by
# fantasy-epl.service. The real file is never committed: by hand it is created once
# (see docs/tasks/deployment-roadmap.md, Phase 4), later the deploy workflow writes it
# from GitHub `production` secrets.

# Fixed for production
NODE_ENV=production
PORT=3001
DATABASE_PATH=/var/lib/fantasy-epl/fpl.sqlite

# Secrets: the server refuses to start if one is missing (config/production.ts)
ADMIN_USERNAME=
ADMIN_PASSWORD=
FPL_TEAM_ID=
