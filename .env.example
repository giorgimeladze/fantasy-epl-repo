# Login for the dashboard (required — the server will not start without both)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Your FPL team (entry) ID — the number in https://fantasy.premierleague.com/entry/<ID>/event/<GW>
FPL_TEAM_ID=
# API port (the Vite dev server proxies /api to this)
PORT=3001
# SQLite file for the team cache (default: app/server/data/fpl.sqlite)
# DATABASE_PATH=
